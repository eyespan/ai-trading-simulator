# AI review provider: "anthropic" (default) or "bedrock".
# Without a working provider configured, the AI review layer automatically
# falls back to a deterministic rule-based explanation, so the app runs
# fully offline regardless.
AI_PROVIDER=bedrock

# --- Option A: direct Anthropic API ---
# Required only if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# --- Option B: AWS Bedrock ---
# Required only if AI_PROVIDER=bedrock. 
#
# If your profile (or its SSO/assume-role config) lives in ~/.aws/config
# rather than ~/.aws/credentials, set AWS_SDK_LOAD_CONFIG=1 or boto3 won't
# see it at all.
AWS_REGION=us-east-1
AWS_SDK_LOAD_CONFIG=1
AWS_PROFILE=ai-trading-similator

# Alternative to AWS_PROFILE: explicit keys (e.g. for CI or containers
# without a mounted ~/.aws/credentials file). Leave blank if using a profile.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# Verify the exact model ID enabled for your account under
# Bedrock > Model access -- these are dated IDs, not the same naming as the
# direct Anthropic API.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
