# AI review provider: "anthropic" (default) or "bedrock".
# Without a working provider configured, the AI review layer automatically
# falls back to a deterministic rule-based explanation, so the app runs
# fully offline regardless.
AI_PROVIDER=bedrock

# --- Option A: direct Anthropic API ---
# Required only if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# --- Option B: AWS Bedrock ---
# Required only if AI_PROVIDER=bedrock. Uses your normal AWS credential
# chain (env vars below, ~/.aws/credentials, SSO, or an instance/task role)
# -- no Anthropic API key needed.
AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
AWS_PROFILE=ai-trading-similator
# Optional override -- verify the exact model ID enabled for your account
# under Bedrock > Model access, since IDs vary by region/account.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
